<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <!-- Only Application is measured: Yumiko.Model is POCOs with no logic. -->
          <Include>[Yumiko.Application]*</Include>
          <!-- Do not add CompilerGeneratedAttribute here: it would exclude the state machines of the
               async methods, which is where the logic of the services lives. -->
          <ExcludeByAttribute>GeneratedCodeAttribute</ExcludeByAttribute>
          <SkipAutoProps>true</SkipAutoProps>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
