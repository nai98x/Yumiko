# Template. Copy it to ~/.config/yumiko-backup/backup.env on the server (chmod 600) and fill it in
# with the real values, which are NOT versioned. The script has no default for any of this: when a
# key is missing it fails naming the one that is missing.
#
# Same format as AnilistConEnie's backup.env: that one can be copied over changing PGDATABASE,
# PGUSER, REMOTE, PREFIJO and ESTADO. Watch out for REMOTE: left pointing at the other bot's
# subfolder, the backups mix and each one eats into the other's retention.
#
# The variable names are in Spanish so that both bots share one config format.

# Connection to the database. The role is READ-ONLY, different from the one the bot uses, and its
# password goes in ~/.pgpass (chmod 600), never here.
PGDATABASE=
PGUSER=
PGHOST=
PGPORT=

# Rclone remote + bucket + this bot's own subfolder. Retention looks inside this folder only, so one
# bot does not prune the other's backups.
REMOTE=<remote>:<bucket>/<subfolder>

# Prefix of the files: <PREFIJO>-YYYY-MM-DD.dump.gpg
PREFIJO=yumiko

# How many copies are kept.
RETENER=5

# Time zone of the date in the file name and in the mark. UTC when omitted.
TZ_BACKUP=

# Encryption passphrase and rclone binary (absolute paths, or with $HOME).
PASSFILE=
RCLONE=

# Mark of the last successful backup. The bot reads it to warn when a day had no backup; it has to
# match Backups__StatePath of the systemd yumiko.env (an absolute path there: systemd does not
# expand $HOME).
ESTADO=
